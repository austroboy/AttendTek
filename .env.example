# Copy to .env for local use, or paste these into Vercel > Settings > Environment Variables
DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=attendtek.vercel.app
DJANGO_CSRF_ORIGINS=https://attendtek.vercel.app

# Set automatically when you add Neon Postgres storage in Vercel.
# Locally you can point at the same database to run migrations:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
