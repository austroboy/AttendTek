{
  "version": 2,
  "builds": [
    {
      "src": "core/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "runtime": "python3.12",
        "maxLambdaSize": "50mb",
        "includeFiles": ["templates/**", "static/**", "apps/**", "core/**"]
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "core/wsgi.py" }
  ]
}
